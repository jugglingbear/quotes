---
import QuoteCard from "../../components/QuoteCard.astro";
import TagFilter from "../../components/TagFilter.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAuthors, type AuthorSummary } from "../../lib/quotes";

export function getStaticPaths() {
  return getAuthors().map((author) => ({ params: { slug: author.slug }, props: { author } }));
}

interface Props {
  author: AuthorSummary;
}

const { author } = Astro.props;
---

<BaseLayout
  title={author.label}
  description={`Browse ${author.quotes.length} quotations attributed to ${author.label}.`}
>
  <header class="page-heading">
    <p class="eyebrow">Author</p>
    <h1>{author.label}</h1>
    <p>
      {author.quotes.length} {author.quotes.length === 1 ? "quote" : "quotes"}
      {author.works.length ? ` across ${author.works.length} ${author.works.length === 1 ? "work" : "works"}` : ""}.
    </p>
  </header>

  <TagFilter tags={author.tags} />

  <div class="section-heading">
    <h2>Quotations</h2>
    <p aria-live="polite"><span data-filtered-quote-count>{author.quotes.length}</span> in the collection</p>
  </div>

  <section id="quote-grid" class="quote-grid">
    {author.quotes.map((quote) => <QuoteCard quote={quote} />)}
  </section>
</BaseLayout>
